# OpenAI (AI-анализ тональности)
OPENAI_API_KEY=sk-ваш-openai-api-ключ
OPENAI_MODEL=gpt-4o-mini

# Gmail API (отправка email через HTTPS, не блокируется хостингом)
# Получить: https://console.cloud.google.com → APIs & Services → Gmail API → Credentials → OAuth Desktop
GMAIL_TOKEN_JSON=base64-ваш-gmail-oauth-token
GMAIL_FROM_EMAIL=your-email@gmail.com

# Email владельца для уведомлений о новых заявках
SMTP_OWNER_EMAIL=owner@example.com

# App (настройки приложения)
APP_NAME=AI Contact API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Rate Limit (ограничение запросов)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# Database (PostgreSQL — для прода, SQLite — для тестов)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contacts
