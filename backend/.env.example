# OpenAI (AI-анализ тональности)
OPENAI_API_KEY=sk-ваш-openai-api-ключ
OPENAI_MODEL=gpt-5.4-mini

# SMTP (почтовые уведомления)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_OWNER_EMAIL=owner@example.com
SMTP_FROM_EMAIL=noreply@example.com

# Mailgun (альтернатива SMTP — HTTP API, не зависит от сети РФ)
# MAILGUN_API_KEY=ваш-mailgun-api-ключ
# MAILGUN_DOMAIN=ваш-sandbox-domain.mailgun.org

# App (настройки приложения)
APP_NAME=AI Contact API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Rate Limit (ограничение запросов)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# Database (PostgreSQL — для прода, SQLite — для локальных тестов)
# В продакшене (Docker) задаётся через docker-compose.yml
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contacts